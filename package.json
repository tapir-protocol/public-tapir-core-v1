{
  "name": "tapir-protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Tapir Protocol core contracts \u2014 a DeFi depeg protection marketplace splitting yield-bearing assets into depeg-protected (DP) and yield-boosted (YB) tranches.",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/tapir-protocol/public-tapir-core-v1.git"
  },
  "homepage": "https://tapir.money",
  "scripts": {
    "test": "npx hardhat test $(find test -name '*.test.ts' ! -name '*.mainnetfork.test.ts' ! -name '*.live.test.ts' -print)",
    "test:mainnetfork": "npx hardhat test test/TapirPtrwOracle.mainnetfork.test.ts",
    "test:factory": "npx hardhat test test/DepegFactory.test.ts",
    "test:pool": "npx hardhat test test/DepegPool.test.ts",
    "test:token": "npx hardhat test test/DepegToken.test.ts",
    "test:oracle": "npx hardhat test test/TapirOracle.test.ts",
    "test:oracle:crosschain": "npx hardhat test test/TapirOracle.crosschain.test.ts",
    "test:decay": "npx hardhat test test/libraries/TimeDecay.test.ts",
    "test:verbose": "npx hardhat test --verbose $(find test -name '*.test.ts' ! -name '*.mainnetfork.test.ts' ! -name '*.live.test.ts' -print)",
    "test:gas": "REPORT_GAS=true npm test",
    "compile": "npx hardhat compile",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "format": "prettier --write 'contracts/**/*.sol'",
    "format:check": "prettier --check 'contracts/**/*.sol'",
    "test:live": "hardhat test test/TapirOracle.live.test.ts",
    "test:router": "hardhat test test/TapirRouter.test.ts",
    "test:ptrw": "hardhat test test/TapirPtrwOracle.test.ts",
    "verify:audit": "python3 scripts/verify-audit.py",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.0.0",
    "chai": "^4.5.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.0.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.2",
    "ethers": "6.17.0"
  },
  "dependencies": {
    "@api3/contracts": "27.0.0",
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "cookie": "0.7.2",
    "diff": "8.0.3",
    "fast-uri": "3.1.6",
    "lodash": "4.18.1",
    "serialize-javascript": "7.1.1",
    "tmp": "0.2.7",
    "undici": "6.28.1",
    "uuid": "11.1.1"
  }
}
